<odoo>
    <record id="l10n_br_fiscal_obra_view_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.obra.tree</field>
        <field name="model">l10n_br_fiscal.obra</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="identification_type" />
                <field name="cno_cei" />
                <field name="street_name" />
            </tree>
        </field>
    </record>

    <record id="l10n_br_fiscal_obra_view_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.obra.form</field>
        <field name="model">l10n_br_fiscal.obra</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="identification_type" />
                            <field name="civil_construction_art" />
                        </group>
                        <group>
                            <field
                                name="cno_cei"
                                attrs="{'invisible': [('identification_type', '!=', 'cno_cei')]}"
                            />
                            <field
                                name="property_registration"
                                attrs="{'invisible': [('identification_type', '!=', 'property_registration')]}"
                            />
                            <field
                                name="street_name"
                                attrs="{'invisible': [('identification_type', '!=', 'address')]}"
                            />
                            <field
                                name="street_number"
                                attrs="{'invisible': [('identification_type', '!=', 'address')]}"
                            />
                            <field
                                name="street_number2"
                                attrs="{'invisible': [('identification_type', '!=', 'address')]}"
                            />
                            <field
                                name="district"
                                attrs="{'invisible': [('identification_type', '!=', 'address')]}"
                            />
                            <field
                                name="zip"
                                attrs="{'invisible': [('identification_type', '!=', 'address')]}"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_fiscal_obra_action" model="ir.actions.act_window">
        <field name="name">Obras</field>
        <field name="res_model">l10n_br_fiscal.obra</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="l10n_br_fiscal_obra_menu"
        name="Obras"
        action="l10n_br_fiscal_obra_action"
        parent="l10n_br_fiscal.others_config_menu"
        sequence="30"
    />
</odoo>
