<odoo>

    <record model="ir.ui.view" id="view_move_form">
        <field
            name="name"
        >account.move.form (in egd_l10n_br_cnab_structure_custom)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="payment_mode_id" position="after">
                <field name="payment_type" invisible="1" />
                <field name="payment_method_code" invisible="1" />
                <field
                    name="barcode"
                    attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': ['|', '|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('payment_method_code', 'not in', ('240', '400', '500', 'manual_test')), ('payment_type', '!=', 'outbound')]}"
                />
            </field>
        </field>
    </record>

</odoo>
