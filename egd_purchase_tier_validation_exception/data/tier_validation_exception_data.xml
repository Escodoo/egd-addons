<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record
        id="tier_validation_exception_purchase_order_line"
        model="tier.validation.exception"
    >
        <field
            name="name"
        >Allow editing Purchase Order lines under Tier Validation</field>
        <field name="model_id" ref="purchase.model_purchase_order" />
        <field
            name="field_ids"
            eval="[(6, 0, [
                ref('purchase.field_purchase_order__order_line'),
                ref('purchase.field_purchase_order__state'),
                ref('purchase.field_purchase_order__date_approve'),
            ])]"
        />
        <field name="allowed_to_write_under_validation" eval="True" />
        <field name="allowed_to_write_after_validation" eval="True" />
    </record>

</odoo>
