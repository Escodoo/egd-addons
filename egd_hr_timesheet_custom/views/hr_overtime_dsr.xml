<odoo>

    <!-- Tree View -->
    <record model="ir.ui.view" id="hr_overtime_dsr_tree_view">
        <field name="name">hr.overtime.dsr.tree</field>
        <field name="model">hr.overtime.dsr</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="month" />
                <field name="year" />
                <field name="working_days" />
                <field name="dsr_count" />
                <field name="create_date" string="Created on" />
                <field name="write_date" string="Last Updated on" />
            </tree>
        </field>
    </record>

    <!-- Action Window -->
    <record model="ir.actions.act_window" id="hr_overtime_dsr_act_window">
        <field name="name">HR Overtime DSR</field>
        <field name="res_model">hr.overtime.dsr</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_timesheet_overtime_dsr"
        parent="hr_timesheet.hr_timesheet_menu_configuration"
        action="hr_overtime_dsr_act_window"
        name="DSR Calculation"
    />

</odoo>
