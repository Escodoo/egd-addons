<odoo>


    <record model="ir.ui.view" id="view_invoice_tree_view">
        <field name="name">account.invoice.tree (in egd_account_custom)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='invoice_date_due']" position="after">
                <field name="egd_invoice_due_date" widget="date" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
